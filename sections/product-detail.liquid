{%- comment -%}
  PDP — works for records, merch, anything.
  product.type detects merch (any type other than blank/"vinyl"/"record" hides vinyl peek).
  Metafields (namespace: sfr):
    cat_no, label, style, release_date, format, color, material, print
  Sizes/variants come from native product.variants. When variants
  exist, a size picker is rendered.
{%- endcomment -%}
{%- assign is_record = false -%}
{%- if product.type == blank or product.type == 'Vinyl' or product.type == 'Record' -%}{%- assign is_record = true -%}{%- endif -%}
{%- assign current_variant = product.selected_or_first_available_variant -%}
{%- assign has_sizes = false -%}
{%- if product.variants.size > 1 -%}{%- assign has_sizes = true -%}{%- endif -%}

{%- comment -%}
  Back target: the collection the visitor actually arrived through when the URL
  carries one (/collections/x/products/y), otherwise inferred from the product
  using the same records-vs-merch split as the panel below.
{%- endcomment -%}
{%- assign back_collection = collection -%}
{%- if back_collection == blank -%}
  {%- if is_record -%}
    {%- assign back_collection = collections.records -%}
  {%- else -%}
    {%- assign back_collection = collections.merch -%}
  {%- endif -%}
{%- endif -%}

<section class="pdp">
  {%- if back_collection != blank and back_collection.url != blank -%}
    <div class="pdp__back-row">
      <a class="pdp__back" href="{{ back_collection.url }}">
        <span class="pdp__back-arrow" aria-hidden="true"></span>
        <span class="pdp__back-label">BACK TO {{ back_collection.title | upcase }}</span>
      </a>
    </div>
  {%- endif -%}
  <div class="pdp__inner">

    <!-- Media -->
    <div class="pdp__media">
      <div class="pdp__cover-wrap">
        {%- if is_record -%}
          <img class="pdp__vinyl" src="{{ 'record.png' | asset_url }}" aria-hidden="true" alt=""
               width="494" height="1565">
        {%- endif -%}
        {%- if product.featured_image -%}
          <img class="pdp__cover" id="pdpMainImg"
               src="{{ product.featured_image | image_url: width: 1200 }}"
               alt="{{ product.title | escape }}"
               width="1200" height="1200"
               loading="eager" fetchpriority="high">
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'pdp__cover' }}
        {%- endif -%}
      </div>
      {%- if product.images.size > 1 -%}
        <div class="pdp__thumbs">
          {%- for img in product.images -%}
            <img class="pdp__thumb{% if forloop.first %} is-active{% endif %}"
                 src="{{ img | image_url: width: 160 }}"
                 alt="{{ product.title | escape }} — image {{ forloop.index }}"
                 width="160" height="160"
                 loading="lazy"
                 data-full="{{ img | image_url: width: 1200 }}">
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <!-- Info Panel -->
    <div class="pdp__panel window">
      <div class="border-left"></div>
      <div class="border-right"></div>
      <div class="window__titlebar">
        <span class="window__text">{% if is_record %}ALBUM INFO{% else %}PRODUCT INFO{% endif %}</span>
      </div>
      <div class="window__content pdp__body">

        {%- if has_sizes -%}
          <div class="pdp__size">
            <span class="pdp__size-label">SIZE</span>
            <div class="pdp__size-options" id="pdpSizeOptions">
              {%- for variant in product.variants -%}
                <button class="pdp__size-btn{% if variant.id == current_variant.id %} is-selected{% endif %}{% unless variant.available %} is-soldout{% endunless %}"
                        type="button"
                        data-variant-id="{{ variant.id }}"
                        data-available="{{ variant.available }}"
                        {% unless variant.available %}aria-disabled="true"{% endunless %}>
                  {{ variant.title }}
                </button>
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}

        <form method="post" action="{{ routes.cart_add_url }}" id="pdpForm" enctype="multipart/form-data">
          <input type="hidden" name="id" id="pdpVariantId" value="{{ current_variant.id }}">
          <input type="hidden" name="quantity" id="pdpQtyHidden" value="1">

          <div class="pdp__purchase">
            <div class="pdp__price">
              <span class="pdp__price-tag{% unless current_variant.available %} is-oos{% endunless %}" id="pdpPriceTag">{{ current_variant.price | money_without_trailing_zeros }}</span>
            </div>
            <div class="pdp__stock{% unless current_variant.available %} is-oos{% endunless %}" id="pdpStock">
              {%- if current_variant.available %}IN STOCK{% else %}OUT OF STOCK{% endif -%}
            </div>
            <div class="pdp__buy">
              <div class="pdp__qty-wrap">
                <button class="pdp__qty-btn" type="button" id="pdpQtyDown">&#8722;</button>
                <span class="pdp__qty-val" id="pdpQtyVal">1</span>
                <button class="pdp__qty-btn" type="button" id="pdpQtyUp">+</button>
              </div>
              <button class="pdp__add-cart" type="submit" id="pdpAddCart"
                      {% unless current_variant.available %}disabled{% endunless %}>
                {%- if current_variant.available -%}ADD TO CART{%- else -%}OUT OF STOCK{%- endif -%}
              </button>
            </div>
          </div>
        </form>

        <div class="pdp__stock-msg{% unless current_variant.available %} is-visible{% endunless %}" id="pdpStockMsg">
          OUT OF STOCK &mdash; PLEASE EMAIL <a href="mailto:{{ settings.stock_email | default: 'info@sfrrecords.com' }}">{{ settings.stock_email | default: 'info@sfrrecords.com' | upcase }}</a> FOR INCOMING.
        </div>

        <!-- Info table -->
        <div class="pdp__table">
          {%- if product.metafields.custom.cat_no != blank -%}
            <div class="pdp__row"><div class="pdp__key">CAT NO</div><div class="pdp__val">{{ product.metafields.custom.cat_no }}</div></div>
          {%- endif -%}
          {%- if is_record -%}
            <div class="pdp__row"><div class="pdp__key">ARTIST</div><div class="pdp__val">{{ product.vendor | upcase }}</div></div>
            <div class="pdp__row"><div class="pdp__key">TITLE</div><div class="pdp__val">{{ product.title | upcase }}</div></div>
            {%- if product.metafields.custom.label != blank -%}
              <div class="pdp__row"><div class="pdp__key">LABEL</div><div class="pdp__val">{{ product.metafields.custom.label | upcase }}</div></div>
            {%- endif -%}
            {%- if product.metafields.custom.style != blank -%}
              <div class="pdp__row"><div class="pdp__key">STYLE</div><div class="pdp__val">{{ product.metafields.custom.style | upcase }}</div></div>
            {%- endif -%}
            {%- if product.metafields.custom.release_date != blank -%}
              <div class="pdp__row"><div class="pdp__key">DATE</div><div class="pdp__val">{{ product.metafields.custom.release_date | date: '%-m.%y' }}</div></div>
            {%- endif -%}
            {%- if product.metafields.custom.format != blank -%}
              <div class="pdp__row"><div class="pdp__key">FORMAT</div><div class="pdp__val">{{ product.metafields.custom.format | upcase }}</div></div>
            {%- endif -%}
          {%- else -%}
            <div class="pdp__row"><div class="pdp__key">TITLE</div><div class="pdp__val">{{ product.title | upcase }}</div></div>
            {%- if product.type != blank -%}
              <div class="pdp__row"><div class="pdp__key">TYPE</div><div class="pdp__val">{{ product.type | upcase }}</div></div>
            {%- endif -%}
            {%- if product.metafields.custom.color != blank -%}
              <div class="pdp__row"><div class="pdp__key">COLOR</div><div class="pdp__val">{{ product.metafields.custom.color | upcase }}</div></div>
            {%- endif -%}
            {%- if product.metafields.custom.material != blank -%}
              <div class="pdp__row"><div class="pdp__key">MATERIAL</div><div class="pdp__val">{{ product.metafields.custom.material | upcase }}</div></div>
            {%- endif -%}
            {%- if product.metafields.custom.print != blank -%}
              <div class="pdp__row"><div class="pdp__key">PRINT</div><div class="pdp__val">{{ product.metafields.custom.print | upcase }}</div></div>
            {%- endif -%}
          {%- endif -%}
        </div>

        <!-- Description -->
        {%- if product.description != blank -%}
          <div class="pdp__desc">
            <div class="pdp__desc-label">DESCRIPTION</div>
            <div class="pdp__desc-body">{{ product.description }}</div>
          </div>
        {%- endif -%}

        <!-- Play clips (only for products with sfr.clips files attached) -->
        {%- assign pdp_clips = product.metafields.custom.clips.value -%}
        {%- if pdp_clips.size > 0 -%}
          {%- capture pdp_clips_json -%}
            [
            {%- for file in pdp_clips -%}
              {%- if file.alt != blank -%}
                {%- assign t = file.alt -%}
              {%- else -%}
                {%- assign t = file.url | split: '?' | first | split: '/' | last | split: '.' | first | replace: '-', ' ' | replace: '_', ' ' | replace: '%20', ' ' | strip -%}
              {%- endif -%}
              {"title":"{{ t | escape }}","url":"{{ file.url }}"}{% unless forloop.last %},{% endunless %}
            {%- endfor -%}
            ]
          {%- endcapture -%}
          <div class="pdp__clips-bar">
            <button type="button" class="pdp__play-clips plp__play"
                    data-clips="{{ pdp_clips_json | strip | escape }}"
                    data-title="{{ product.title | escape }}"
                    data-artist="{{ product.vendor | escape }}"
                    data-cover="{{ product.featured_image | image_url: width: 1200 }}"
                    data-variant-id="{{ current_variant.id }}"
                    data-available="{{ current_variant.available }}">
              <svg width="12" height="14" viewBox="0 0 12 14" fill="currentColor" aria-hidden="true" style="flex-shrink:0"><polygon points="0,0 0,14 12,7"/></svg>
              PLAY CLIPS
            </button>
          </div>
        {%- endif -%}

      </div>
    </div>

  </div>
</section>

<script>
(function () {
  /* Slide the vinyl out from behind the cover — but hold it until both the
     sleeve and the record have actually decoded, or it slides out from behind
     an empty box on a cold cache.
     Double rAF guarantees the initial left:0 paints before we change to left:100%
     so the CSS transition actually runs. */
  const vinyl = document.querySelector('.pdp__vinyl');
  if (vinyl) {
    const cover = document.getElementById('pdpMainImg');
    function settled(img) {
      if (!img) return Promise.resolve();                      /* placeholder SVG, no <img> */
      if (img.complete && img.naturalWidth > 0) return Promise.resolve();
      return new Promise(function (done) {
        img.addEventListener('load', done, { once: true });
        img.addEventListener('error', done, { once: true });    /* a broken image must not stall it */
      });
    }
    /* Race a timeout so a hanging request can never strand the record behind the sleeve. */
    Promise.race([
      Promise.all([settled(vinyl), settled(cover)]),
      new Promise(function (done) { setTimeout(done, 3000); })
    ]).then(function () {
      requestAnimationFrame(() => requestAnimationFrame(() => { vinyl.style.left = '100%'; }));
    });
  }

  /* Variant data for client-side switching.
     `max` is the purchasable ceiling: real stock when Shopify tracks the variant
     with a "deny" policy, otherwise NO_CAP because oversell is permitted. */
  const NO_CAP = 9999;
  const variants = {
    {%- for variant in product.variants -%}
      {%- liquid
        assign v_max = 9999
        if variant.inventory_management != blank and variant.inventory_policy == 'deny'
          assign v_max = variant.inventory_quantity | at_least: 0
        endif
      -%}
      "{{ variant.id }}": {
        id: {{ variant.id }},
        title: {{ variant.title | json }},
        price: {{ variant.price | json }},
        priceFormatted: {{ variant.price | money_without_trailing_zeros | json }},
        available: {{ variant.available }},
        max: {{ v_max }},
        featured_image: {{ variant.featured_image.src | json | default: '""' }}
      }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  };

  const qtyVal = document.getElementById('pdpQtyVal');
  const qtyHidden = document.getElementById('pdpQtyHidden');
  const qtyUpBtn = document.getElementById('pdpQtyUp');
  const qtyDownBtn = document.getElementById('pdpQtyDown');
  const sizeOptions = document.getElementById('pdpSizeOptions');
  const variantIdInput = document.getElementById('pdpVariantId');
  const priceEl = document.getElementById('pdpPriceTag');
  const stockEl = document.getElementById('pdpStock');
  const stockMsg = document.getElementById('pdpStockMsg');
  const addBtn = document.getElementById('pdpAddCart');

  /* Qty +/- — clamped to the selected variant's stock, so + stops dead at the
     last available unit instead of counting up forever. */
  function variantMax() {
    const v = variants[variantIdInput.value];
    return v && typeof v.max === 'number' ? Math.max(1, v.max) : NO_CAP;
  }
  function setQty(n) {
    const max = variantMax();
    const v = Math.min(Math.max(1, parseInt(n, 10) || 1), max);
    qtyVal.textContent = v;
    qtyHidden.value = v;
    qtyUpBtn.disabled = v >= max;
    qtyDownBtn.disabled = v <= 1;
    return v;
  }
  qtyDownBtn.addEventListener('click', () => setQty(parseInt(qtyVal.textContent, 10) - 1));
  qtyUpBtn.addEventListener('click', () => setQty(parseInt(qtyVal.textContent, 10) + 1));
  setQty(1);

  /* Size variant picker */
  function applyVariant(v) {
    if (!v) return;
    variantIdInput.value = v.id;
    if (priceEl) priceEl.textContent = v.priceFormatted;
    if (stockEl) {
      stockEl.textContent = v.available ? 'IN STOCK' : 'OUT OF STOCK';
      stockEl.classList.toggle('is-oos', !v.available);
    }
    if (priceEl) priceEl.classList.toggle('is-oos', !v.available);
    if (stockMsg) stockMsg.classList.toggle('is-visible', !v.available);
    if (addBtn) {
      if (v.available) { addBtn.removeAttribute('disabled'); addBtn.textContent = 'ADD TO CART'; }
      else             { addBtn.setAttribute('disabled', 'disabled'); addBtn.textContent = 'OUT OF STOCK'; }
    }
    /* Re-clamp: the new variant may hold less stock than the old one. */
    setQty(qtyVal.textContent);
  }
  if (sizeOptions) {
    sizeOptions.addEventListener('click', (e) => {
      const btn = e.target.closest('.pdp__size-btn');
      if (!btn) return;
      sizeOptions.querySelectorAll('.pdp__size-btn').forEach(b => b.classList.toggle('is-selected', b === btn));
      applyVariant(variants[btn.getAttribute('data-variant-id')]);
    });
  }

  /* Thumbnail switching */
  document.querySelectorAll('.pdp__thumb').forEach(t => {
    t.addEventListener('click', () => {
      document.querySelectorAll('.pdp__thumb').forEach(x => x.classList.remove('is-active'));
      t.classList.add('is-active');
      const full = t.getAttribute('data-full');
      if (full) document.getElementById('pdpMainImg').src = full;
    });
  });

  /* AJAX add-to-cart (so we don't leave the page) */
  const form = document.getElementById('pdpForm');
  form.addEventListener('submit', async function (e) {
    e.preventDefault();
    if (!window.SFRCart) { form.submit(); return; }
    const id = parseInt(variantIdInput.value, 10);
    const want = parseInt(qtyHidden.value, 10) || 1;
    const max = variantMax();
    try {
      let qty = want;
      if (max < NO_CAP) {
        /* The stepper caps a single add; this also accounts for units already
           sitting in the cart, since /cart/add.js stacks onto existing lines. */
        const room = max - (await SFRCart.inCart(id));
        if (room <= 0) {
          SFRCart.flash(addBtn, 'MAX IN CART');
          if (window.SFRToast) SFRToast.show('ALL AVAILABLE STOCK IS ALREADY IN YOUR CART');
          return;
        }
        qty = Math.min(want, room);
      }
      await SFRCart.add({ id: id, quantity: qty });
      SFRCart.flash(addBtn, qty < want ? 'ADDED ' + qty + ' ✓' : 'ADDED ✓');
      if (qty < want && window.SFRToast) SFRToast.show('ONLY ' + qty + ' LEFT — ADDED ' + qty);
    } catch (err) {
      SFRCart.flash(addBtn, 'ERROR');
      if (window.SFRToast && err && err.cartMessage) SFRToast.show(err.cartMessage.toUpperCase());
    }
  });
})();
</script>

{% schema %}
{
  "name": "Product detail",
  "settings": [],
  "presets": [
    { "name": "Product detail" }
  ]
}
{% endschema %}
