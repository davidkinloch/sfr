{%- comment -%}
  Contact / About — single contained window, one column (2026-08 design).
  Stacked: socials, contact form (email, name, message), about copy.
  About copy comes from section.settings.about_html (rich text).

  Width is contained via .contact-page__inner--narrow rather than by changing
  .contact-page__inner itself, because main-page.liquid (About Us, Distribution
  and every generic page) shares that class and must stay full width.
{%- endcomment -%}
<section class="contact-page" id="contact">
  <img class="about-us__homie" src="{{ 'sfr-homie.png' | asset_url }}" alt="" aria-hidden="true"
       width="917" height="963" loading="lazy">
  <div class="contact-page__inner contact-page__inner--narrow">

    <div class="contact-window window">
      <div class="border-left"></div>
      <div class="border-right"></div>
      <div class="window__titlebar">
        <span class="window__text">{{ section.settings.titlebar | default: 'CONTACT' }}</span>
      </div>
      <div class="window__content contact-window__body contact-window__body--single">

        <div class="contact-window__col">

          <div class="contact-info__socials">
            <a class="mac-btn" href="{{ section.settings.instagram_url | default: '#' }}" target="_blank" rel="noopener">INSTAGRAM</a>
            <a class="mac-btn" href="{{ section.settings.youtube_url   | default: '#' }}" target="_blank" rel="noopener">YOUTUBE</a>
            <a class="mac-btn" href="{{ section.settings.discogs_url   | default: '#' }}" target="_blank" rel="noopener">DISCOGS</a>
          </div>

          {%- form 'contact', class: 'contact-form', id: 'contactForm' -%}
            <div class="contact-form__group">
              <label class="contact-form__label" for="cfName">NAME</label>
              <input class="contact-form__input" type="text" id="cfName" name="contact[name]" placeholder="YOUR NAME" required>
            </div>

            <div class="contact-form__group">
              <label class="contact-form__label" for="cfEmail">CONTACT</label>
              <input class="contact-form__input" type="email" id="cfEmail" name="contact[email]" placeholder="EMAIL ADDRESS" required>
            </div>

            <div class="contact-form__group">
              <label class="contact-form__label" for="cfMessage">MESSAGE</label>
              <textarea class="contact-form__input" id="cfMessage" name="contact[body]" rows="5" placeholder="YOUR MESSAGE" required></textarea>
            </div>

            <label class="contact-form__check">
              <input type="checkbox" name="contact[news]" value="1">
              <span class="contact-form__check-box" aria-hidden="true"></span>
              <span>EMAIL ME WITH NEWS AND OFFERS</span>
            </label>

            {%- if form.errors -%}
              <div class="contact-form__error is-visible">{{ form.errors | default_errors }}</div>
            {%- endif -%}
            {%- if form.posted_successfully? -%}
              <p class="contact-form__thanks" id="contactThanks" style="color:#838383">
                THANK YOU!<br>
                WE WILL REPLY TO YOUR MESSAGE AS SOON AS POSSIBLE<br>
                &mdash; SFR RECORDS
              </p>
            {%- endif -%}

            <button type="submit" class="contact-form__send">SEND</button>
          {%- endform -%}

          {%- comment -%}
            Hidden newsletter signup — Shopify's `customer` form really subscribes
            the email to email marketing. Submitted via JS (sendBeacon) when the
            "EMAIL ME WITH NEWS AND OFFERS" box is ticked, so it runs alongside
            the contact form's normal submit.
          {%- endcomment -%}
          {%- form 'customer', id: 'contactNewsletterForm', class: 'contact-newsletter-form' -%}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <input type="hidden" name="contact[email]" id="cfNewsEmail" value="">
          {%- endform -%}

          <div class="about-us__copy contact-window__copy">
            {{ section.settings.about_html }}
          </div>

        </div>

      </div>
    </div>

  </div>
</section>

<script>
(function () {
  /* Real newsletter signup: when the news checkbox is ticked, subscribe the
     entered email via the hidden customer (newsletter) form. sendBeacon posts
     in the background so it survives the contact form's full-page submit. */
  const contactForm = document.getElementById('contactForm');
  const newsForm    = document.getElementById('contactNewsletterForm');
  const newsCheck   = contactForm && contactForm.querySelector('input[name="contact[news]"]');
  const emailInput  = document.getElementById('cfEmail');
  const newsEmail   = document.getElementById('cfNewsEmail');
  if (contactForm && newsForm && newsCheck && emailInput && newsEmail) {
    contactForm.addEventListener('submit', function () {
      /* submit only fires once HTML5 validation passes, so email is valid here */
      if (newsCheck.checked && emailInput.value) {
        newsEmail.value = emailInput.value;
        try { navigator.sendBeacon(newsForm.action, new FormData(newsForm)); } catch (e) {}
      }
    });
  }
})();
</script>

{% schema %}
{
  "name": "Contact / About",
  "settings": [
    { "type": "text",         "id": "titlebar",       "label": "Titlebar text", "default": "CONTACT" },
    { "type": "url",          "id": "instagram_url",  "label": "Instagram URL" },
    { "type": "url",          "id": "youtube_url",    "label": "YouTube URL" },
    { "type": "url",          "id": "discogs_url",    "label": "Discogs URL" },
    { "type": "richtext",     "id": "about_html",     "label": "About copy" }
  ],
  "presets": [
    { "name": "Contact / About" }
  ]
}
{% endschema %}
