# Editor / atomic-write temp files. Without these the `theme dev` watcher can catch a
# *.tmp.<pid>.<hash> file mid-save and try to upload it, which Shopify rejects as an
# illegal filename.
*.tmp
*.tmp.*
*~
*.swp
*.swo
.DS_Store

# Repo/tooling files that are not part of the theme upload.
.git/*
.github/*
node_modules/*
.shopify/*
shopify.theme.toml
.theme-check.yml
.prettierrc.json
package.json
package-lock.json
SHOPIFY-SETUP.md
