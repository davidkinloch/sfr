{%- assign main_menu = linklists['main-menu'] -%}
{%- assign cart_count = cart.item_count | default: 0 -%}

{%- comment -%}
  A PDP's own URL (product.url) never contains /collections/..., so link.active
  alone misses "on a Records product page, highlight RECORDS". Build the set of
  collections the current product belongs to and match it against each nav
  link's target collection handle instead.
{%- endcomment -%}
{%- assign product_collection_handles = '|' -%}
{%- if template.name == 'product' -%}
  {%- for c in product.collections -%}
    {%- assign product_collection_handles = product_collection_handles | append: c.handle | append: '|' -%}
  {%- endfor -%}
{%- endif -%}
<nav class="topnav">
  <div class="container">

    <!-- ═══ MENU ═══ -->
    <div class="window menu">
      <div class="border-left"></div>
      <div class="border-right"></div>
      <div class="window__titlebar menu__titlebar" onclick="this.parentElement.classList.toggle('is-open')">
        <div class="window__close"></div>
        <div class="window__text">Menu</div>
      </div>
      <ul class="window__content menu__list">
        {%- for link in main_menu.links -%}
          {%- assign is_active = link.active -%}
          {%- if link.url contains '/collections/' -%}
            {%- assign link_handle = link.url | split: '/collections/' | last | split: '/' | first -%}
            {%- assign link_needle = '|' | append: link_handle | append: '|' -%}
            {%- if product_collection_handles contains link_needle -%}
              {%- assign is_active = true -%}
            {%- endif -%}
          {%- endif -%}
          <li><a class="menu__item{% if is_active %} is-active{% endif %}" href="{{ link.url }}">{{ link.title | upcase }}</a></li>
        {%- endfor -%}
      </ul>
    </div>

    <!-- ═══ SFR RECORDS (clickable logo → home) ═══ -->
    <div class="window sfr">
      <div class="border-left"></div>
      <div class="border-right"></div>
      <div class="window__titlebar sfr__titlebar">
        <div class="window__close"></div>
        <div class="window__text">SFR Records</div>
      </div>
      <div class="window__content sfr__body">
        <a href="{{ routes.root_url }}" aria-label="Back to home">
          <img class="sfr__hero" src="{{ 'snakefreeroofing-logo.png' | asset_url }}" alt="{{ shop.name }}"
               width="1166" height="300" loading="eager" fetchpriority="high">
        </a>
      </div>
    </div>

    <!-- ═══ LOG IN / ACCOUNT ═══ -->
    <a class="login" href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" data-logged-in="{% if customer %}true{% else %}false{% endif %}">
      <div class="login__avatar"></div>
      <span class="login__label">{% if customer %}ACCOUNT{% else %}LOG IN{% endif %}</span>
    </a>

    <!-- ═══ CHECK OUT ═══ -->
    <a class="checkout" href="{{ routes.cart_url }}">
      <div class="checkout__cart">
        <span class="checkout__badge">{{ cart_count }}</span>
      </div>
      <span class="checkout__label">CHECK OUT</span>
    </a>

  </div>
</nav>

